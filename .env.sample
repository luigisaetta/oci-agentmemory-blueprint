# Oracle Autonomous Database connection settings.
# Copy this file to .env and replace the placeholder values locally.
# Never commit the resulting .env file or database credentials.
DB_USER=
DB_PWD=
WALLET_DIR=
WALLET_PWD=
DB_DSN=

# Oracle Autonomous Database connection pool settings.
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=1

# Shared Oracle Agent Memory store identifier. This is not a secret.
# All examples use this value to access the same managed schema objects.
# IN THE VALUE DON'T PUT AN "_" OTHERWISE IT WILL BE DUPLICATED!
MEMORY_STORE_ID=OAM

# OCI Generative AI settings used by the Resource Principal example.
# These values are not secrets. The OCI runtime provides the principal token.
GENAI_COMPARTMENT_ID=
GENAI_REGION=
