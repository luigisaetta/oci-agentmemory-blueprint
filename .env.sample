# Oracle Autonomous Database connection settings.
# Copy this file to .env and replace the placeholder values locally.
# Never commit the resulting .env file or database credentials.
DB_USER=
DB_PWD=
WALLET_DIR=
WALLET_PWD=
DB_DSN=

# Oracle Autonomous Database connection pool settings.
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=1